cc_binary {
    name: "aoad",
    srcs: [
        "main.cpp",
        "UsbAoaService.cpp",
        "VendorControlRequestMonitor.cpp",
        "AccessoryLegacyBridgeThread.cpp",
    ],

    // Standard system includes
    shared_libs: [
        "libbase",
        "libbinder",
        "liblog",
        "libutils",
        "libselinux",
        "libstatslog",
        "libasyncio",
        "android.hardware.usb.aoa-cpp",
    ],

    // Init script to start the daemon
    init_rc: ["aoad.rc"],

    cflags: [
        "-Wall",
        "-Werror",
    ],
}
